# Supabase is the production database and product image storage.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SESSION_SECRET=
ADMIN_EMAIL=
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-long-password',12))"
ADMIN_PASSWORD_HASH=
APP_URL=http://127.0.0.1:3000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=openai
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
EMAIL_FROM=

# Server-side GoldAPI.io token for XAU/INR reference rates. Never use NEXT_PUBLIC.
GOLD_API_TOKEN=

# Run supabase/setup.sql in the Supabase SQL Editor before using production data.
# SESSION_SECRET is required in production; use a strong random value.

# After setting private ADMIN_EMAIL and ADMIN_PASSWORD_HASH locally, run:
# npm run setup:admin
# This stores the bcrypt administrator record in protected Supabase storage.
# A configured Supabase administrator supersedes bootstrap Vercel credentials.
